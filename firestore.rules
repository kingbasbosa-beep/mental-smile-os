rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    function isClient() {
      return signedIn() && request.auth.token.role == 'client';
    }

    function isClinician() {
      return signedIn() && request.auth.token.role == 'clinician';
    }

    function isCenter() {
      return signedIn() && request.auth.token.role == 'center';
    }

    function protectedAccountFields() {
      return [
        'role',
        'isAdmin',
        'approvalStatus',
        'isActive',
        'active',
        'isBlocked',
        'blockedAt',
        'blockedBy',
        'blockReason',
        'adminNotes',
        'verifiedAt',
        'verifiedBy',
        'featured',
        'ranking',
        'subscriptionStatus'
      ];
    }

    function noProtectedAccountFieldChange() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(protectedAccountFields());
    }

    function ownDoc(docId) {
      return signedIn() && docId == uid();
    }

    function approvedActive() {
      return resource != null
        && resource.data.approvalStatus == 'approved'
        && (
          resource.data.isActive == true
          || resource.data.active == true
        )
        && resource.data.isBlocked != true;
    }

    function clientCreateValid(docId) {
      return ownDoc(docId)
        && request.resource.data.role == 'client'
        && !request.resource.data.keys().hasAny([
          'isAdmin',
          'approvalStatus',
          'isActive',
          'active',
          'isBlocked',
          'blockedAt',
          'blockedBy',
          'blockReason',
          'adminNotes',
          'verifiedAt',
          'verifiedBy'
        ]);
    }

    function clientUpdateValid(docId) {
      return ownDoc(docId)
        && noProtectedAccountFieldChange()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'avatarAsset',
          'photoUrl',
          'updatedAt'
        ]);
    }

    function clinicianCreateValid(docId) {
      return ownDoc(docId)
        && request.resource.data.role == 'clinician'
        && request.resource.data.isAdmin != true
        && request.resource.data.isActive == false
        && request.resource.data.isBlocked != true
        && request.resource.data.approvalStatus == 'pending_review';
    }

    function clinicianSelfRegistrationFields() {
      return [
        'displayName',
        'fullName',
        'fullDisplayNameAr',
        'fullDisplayNameEn',
        'email',
        'professionalTitle',
        'professionalTitleKey',
        'professionalTitleLabelAr',
        'professionalTitleLabelEn',
        'specialty',
        'specialtyKey',
        'specialtyLabel',
        'phoneNumber',
        'countryCode',
        'photoUrl',
        'photoAsset',
        'bio',
        'sessionPriceText',
        'sessionDurationText',
        'sessionModes',
        'offersGroupSessions',
        'identityFileName',
        'certificateFileName',
        'extraFileName',
        'documentsSubmitted',
        'documentsUploadMode',
        'identityDocumentUrl',
        'certificateDocumentUrl',
        'extraDocumentUrl',
        'updatedAt',
        'createdAt'
      ];
    }

    function clinicianSelfUpdateValid(docId) {
      return ownDoc(docId)
        && noProtectedAccountFieldChange()
        && resource.data.approvalStatus != 'approved'
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(clinicianSelfRegistrationFields());
    }

    function centerCreateValid(docId) {
      return ownDoc(docId)
        && request.resource.data.role == 'center'
        && request.resource.data.isAdmin != true
        && request.resource.data.isActive == false
        && (
          !request.resource.data.keys().hasAny(['active'])
          || request.resource.data.active == false
        )
        && request.resource.data.isBlocked != true
        && request.resource.data.approvalStatus == 'pending_admin';
    }

    function centerSelfRegistrationFields() {
      return [
        'name',
        'centerName',
        'displayName',
        'email',
        'category',
        'categoryLabelAr',
        'categoryLabelEn',
        'centerType',
        'centerTypeLabelAr',
        'centerTypeLabelEn',
        'sortOrder',
        'managerName',
        'phone',
        'phoneNumber',
        'whatsapp',
        'whatsappNumber',
        'countryCode',
        'city',
        'area',
        'address',
        'description',
        'hasDetoxUnit',
        'galleryItems',
        'galleryImages',
        'imageUrl',
        'coverImageUrl',
        'imagesReady',
        'accommodationCosts',
        'autismCareCosts',
        'centerCapabilities',
        'services',
        'pricingReady',
        'documentItems',
        'documentsReady',
        'identityDocumentUrl',
        'licenseDocumentUrl',
        'commercialDocumentUrl',
        'taxDocumentUrl',
        'identityFileName',
        'licenseFileName',
        'commercialFileName',
        'taxFileName',
        'documentsUploadMode',
        'updatedAt',
        'createdAt'
      ];
    }

    function centerSelfUpdateValid(docId) {
      return ownDoc(docId)
        && noProtectedAccountFieldChange()
        && resource.data.approvalStatus != 'approved'
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(centerSelfRegistrationFields());
    }

    function isOwnBooking() {
      return resource != null
        && (
          resource.data.clientId == uid()
          || resource.data.clinicianId == uid()
          || resource.data.clinicianUid == uid()
          || resource.data.assignedClinicianId == uid()
          || resource.data.assignedClinicianUid == uid()
          || resource.data.centerId == uid()
        );
    }

    function bookingCreateValid() {
      return signedIn()
        && (
          request.resource.data.clientId == uid()
          || request.resource.data.clinicianId == uid()
          || request.resource.data.clinicianUid == uid()
          || request.resource.data.centerId == uid()
        );
    }

    function bookingUserUpdateValid() {
      return isOwnBooking()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'note',
          'threadId',
          'contract',
          'paymentStatus',
          'payment_confirmed',
          'paymentReceiptFileName',
          'paymentReceiptUrl',
          'paymentSubmittedAt',
          'paymentClientNote',
          'centerAvailabilityStatus',
          'centerAvailabilityNote',
          'centerAvailabilityUpdatedAt',
          'arrivalConfirmed',
          'arrivalConfirmedAt',
          'clientReviewSubmitted',
          'clientReviewSubmittedAt',
          'clientReviewTotalScore',
          'clientReviewPercentage',
          'clientReviewDerivedStars',
          'clinicianReviewSubmitted',
          'clinicianReviewSubmittedAt',
          'clinicianReviewTotalScore',
          'clinicianReviewPercentage',
          'clinicianReviewDerivedStars',
          'centerReviewSubmitted',
          'centerReviewSubmittedAt',
          'centerReviewTotalScore',
          'centerReviewPercentage',
          'centerReviewDerivedStars',
          'reviewStatus',
          'sessionStatus',
          'finalReviewPercentage',
          'updatedAt'
        ]);
    }

    function ownClinicianProfileRequest() {
      return signedIn()
        && (
          resource.data.clinicianId == uid()
          || resource.data.ownerId == uid()
        );
    }

    function ownCenterProfileRequest() {
      return signedIn()
        && (
          resource.data.centerId == uid()
          || resource.data.ownerId == uid()
        );
    }

    function profileRequestCreateValid(ownerField) {
      return signedIn()
        && request.resource.data[ownerField] == uid()
        && request.resource.data.status == 'pending'
        && (
          !request.resource.data.keys().hasAny(['ownerId'])
          || request.resource.data.ownerId == uid()
        )
        && !request.resource.data.keys().hasAny(protectedAccountFields());
    }

    function profileRequestAdminUpdateValid() {
      return isAdmin()
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          || request.resource.data.status in ['approved', 'rejected', 'applied']
        );
    }

    function canReadRating() {
      return isAdmin()
        || (
          signedIn()
          && resource != null
          && (
            resource.data.clientId == uid()
            || resource.data.clinicianId == uid()
            || resource.data.centerId == uid()
            || resource.data.reviewerUid == uid()
          )
        );
    }

    function ratingWriteValid() {
      return signedIn()
        && request.resource.data.reviewerUid == uid()
        && request.resource.data.reviewerType in ['client', 'clinician', 'center']
        && request.resource.data.requestId is string;
    }

    match /clients/{clientId} {
      allow read: if isAdmin() || (signedIn() && clientId == uid());
      allow create: if clientCreateValid(clientId) || isAdmin();
      allow update: if isAdmin() || clientUpdateValid(clientId);
      allow delete: if false;
    }

    match /clinicians/{clinicianId} {
      allow read: if isAdmin()
        || (signedIn() && clinicianId == uid())
        || approvedActive();
      allow create: if clinicianCreateValid(clinicianId) || isAdmin();
      allow update: if isAdmin() || clinicianSelfUpdateValid(clinicianId);
      allow delete: if false;
    }

    match /centers/{centerId} {
      allow read: if isAdmin()
        || (signedIn() && centerId == uid())
        || approvedActive();
      allow create: if centerCreateValid(centerId) || isAdmin();
      allow update: if isAdmin() || centerSelfUpdateValid(centerId);
      allow delete: if false;
    }

    match /booking_requests/{requestId} {
      allow read: if isAdmin() || isOwnBooking();
      allow create: if bookingCreateValid() || isAdmin();
      allow update: if isAdmin() || bookingUserUpdateValid();
      allow delete: if false;
    }

    match /bookingRequests/{requestId} {
      allow read, write: if false;
    }

    match /sessionRatings/{ratingId} {
      allow read: if canReadRating();
      allow create: if ratingWriteValid();
      allow update: if ratingWriteValid()
        && resource.data.reviewerUid == uid()
        && request.resource.data.reviewerUid == resource.data.reviewerUid
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.reviewerType == resource.data.reviewerType;
      allow delete: if false;
    }

    match /clinician_profile_change_requests/{requestId} {
      allow read: if isAdmin() || ownClinicianProfileRequest();
      allow create: if profileRequestCreateValid('clinicianId');
      allow update: if profileRequestAdminUpdateValid();
      allow delete: if false;
    }

    match /center_profile_change_requests/{requestId} {
      allow read: if isAdmin() || ownCenterProfileRequest();
      allow create: if profileRequestCreateValid('centerId');
      allow update: if profileRequestAdminUpdateValid();
      allow delete: if false;
    }

    match /support_requests/{requestId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.createdByUid == uid());
      allow create: if signedIn()
        && request.resource.data.createdByUid == uid()
        && request.resource.data.status == 'new'
        && request.resource.data.source == 'structured_support';
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /chat_threads/{threadId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.ownerUid == uid())
        || (signedIn() && resource.data.assignedClinicianUid == uid());
      allow create: if signedIn()
        && request.resource.data.ownerUid == uid();
      allow update: if isAdmin()
        || (signedIn() && resource.data.ownerUid == uid());
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAdmin()
          || (
            signedIn()
            && exists(/databases/$(database)/documents/chat_threads/$(threadId))
            && (
              get(/databases/$(database)/documents/chat_threads/$(threadId)).data.ownerUid == uid()
              || get(/databases/$(database)/documents/chat_threads/$(threadId)).data.assignedClinicianUid == uid()
            )
          );
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/chat_threads/$(threadId));
        allow update, delete: if false;
      }
    }

    match /chat_escalations/{escalationId} {
      allow read: if isAdmin()
        || (
          isClinician()
          && resource.data.assignedToType == 'clinician'
          && resource.data.assignedToUid == uid()
        );
      allow create: if signedIn();
      allow update: if isAdmin();
      allow delete: if false;

      match /reports/{reportId} {
        allow read: if isAdmin()
          || (
            isClinician()
            && exists(/databases/$(database)/documents/chat_escalations/$(escalationId))
            && get(/databases/$(database)/documents/chat_escalations/$(escalationId)).data.assignedToUid == uid()
          );
        allow create: if signedIn();
        allow update, delete: if false;
      }
    }

    match /admins/{adminId} {
      allow read, write: if isAdmin();
      allow delete: if false;
    }

    match /system_health/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /analytics_summaries/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /system_domains/{docId} {
      allow read, write: if isAdmin();
      allow delete: if false;
    }

    match /ai_policies/{docId} {
      allow read, write: if isAdmin();
      allow delete: if false;
    }

    match /resources/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
      allow delete: if false;
    }

    match /external_follow_up_registry/{docId} {
      allow read, write: if isAdmin();
      allow delete: if false;
    }

    match /external_follow_up_message_templates/{docId} {
      allow read, write: if isAdmin();
      allow delete: if false;
    }

    match /external_follow_up_campaigns/{docId} {
      allow read, write: if isAdmin();
      allow delete: if false;
    }

    match /debug/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
