        && request.resource.data.lastCenterAvailabilityNote == resource.data.lastCenterAvailabilityNote
        && request.resource.data.lastCenterSuggestedAlternativeKey == resource.data.lastCenterSuggestedAlternativeKey
        && request.resource.data.lastCenterSuggestedAlternativeLabelAr == resource.data.lastCenterSuggestedAlternativeLabelAr
        && request.resource.data.assignedClinicianId == resource.data.assignedClinicianId
        && request.resource.data.assignedClinicianName == resource.data.assignedClinicianName
        && request.resource.data.clinicianId == resource.data.clinicianId
        && request.resource.data.clinicianName == resource.data.clinicianName
        && request.resource.data.clinicianUid == resource.data.clinicianUid;
    }

    function adminCenterUpdateValid() {
      return adminCenterFollowUpValid()
        || adminCenterReturnToClientValid()
        || adminCenterApproveValid()
        || adminCenterRejectValid();
    }

    function centerAvailabilityUpdateValid() {
      return signedIn()
        && resource.data.requestKind == 'center'
        && (resource.data.centerId is string)
        && resource.data.centerId == uid()
        && resource.data.status == 'center_follow_up'
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.clientName == resource.data.clientName
        && request.resource.data.centerId == resource.data.centerId
        && request.resource.data.centerName == resource.data.centerName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.note == resource.data.note
        && request.resource.data.selectedAccommodationKey == resource.data.selectedAccommodationKey
        && request.resource.data.selectedAccommodationLabelAr == resource.data.selectedAccommodationLabelAr
        && request.resource.data.selectedAccommodationPricingSnapshot == resource.data.selectedAccommodationPricingSnapshot
        && request.resource.data.selectedAccommodationPrice == resource.data.selectedAccommodationPrice
        && request.resource.data.selectedAccommodationPricingUnit == resource.data.selectedAccommodationPricingUnit
        && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly([
              'centerAvailabilityStatus',
              'centerAvailabilityNote',
              'centerSuggestedAlternativeKey',
              'centerSuggestedAlternativeLabelAr',
              'centerAvailabilityRespondedAt',
              'centerAvailabilityRespondedBy',
              'status',
              'workflowStage',
              'updatedAt'
            ])
        && (
          request.resource.data.centerAvailabilityStatus == 'available'
          || request.resource.data.centerAvailabilityStatus == 'unavailable'
        )
        && (
          (
            request.resource.data.centerAvailabilityStatus == 'available'
            && request.resource.data.status == 'center_intake_pending'
            && request.resource.data.workflowStage == 'center_intake_pending'
          )
          || (
            request.resource.data.centerAvailabilityStatus == 'unavailable'
            && request.resource.data.status == resource.data.status
            && request.resource.data.workflowStage == resource.data.workflowStage
          )
        )
        && (
          request.resource.data.centerAvailabilityNote == null
          || request.resource.data.centerAvailabilityNote is string
        )
        && (request.resource.data.centerAvailabilityRespondedBy is string)
        && request.resource.data.centerAvailabilityRespondedBy == uid();
    }

    function centerAvailabilityBridgeValid() {
      return signedIn()
        && resource.data.requestKind == 'center'
        && (resource.data.centerId is string)
        && resource.data.centerId == uid()
        && resource.data.status == 'center_follow_up'
        && request.resource.data.requestKind == resource.data.requestKind
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.centerId == resource.data.centerId
        && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly([
              'centerAvailabilityStatus',
              'centerAvailabilityNote',
              'centerSuggestedAlternativeKey',
              'centerSuggestedAlternativeLabelAr',
              'centerAvailabilityRespondedAt',
              'centerAvailabilityRespondedBy',
              'status',
              'workflowStage',
              'updatedAt'
            ])
        && (
          request.resource.data.centerAvailabilityStatus == 'available'
          || request.resource.data.centerAvailabilityStatus == 'unavailable'
        )
        && (
          (
            request.resource.data.centerAvailabilityStatus == 'available'
            && request.resource.data.status == 'center_intake_pending'
            && request.resource.data.workflowStage == 'center_intake_pending'
          )
          || (
            request.resource.data.centerAvailabilityStatus == 'unavailable'
            && request.resource.data.status == resource.data.status
            && request.resource.data.workflowStage == resource.data.workflowStage
          )
        )
        && (request.resource.data.centerAvailabilityRespondedBy is string)
        && request.resource.data.centerAvailabilityRespondedBy == uid();
    }

    function clientInitialIntakeValid() {
      return isClientDoc()
        && isLegacyOrCanonicalCenterBooking()
        && resource.data.status == 'center_intake_pending'
        && request.resource.data.status == 'center_recommendation_pending'
        && request.resource.data.workflowStage == 'center_recommendation_pending'
        && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly([
              'status',
              'workflowStage',
              'intakeFormSubmitted',
              'intakeSubmittedAt',
              'intakeReason',
              'intakeHasSubstanceUse',
              'intakeSubstanceType',
              'intakeLastSubstanceUseAt',
              'intakeWithdrawalSymptomsText',
              'intakePriorDetoxHistory',
              'intakeHasPriorDiagnosis',
              'intakePriorDiagnosisText',
              'intakeHasPriorTreatment',
              'intakeCurrentMedications',
              'intakeSymptomsText',
              'intakeRiskNotes',
              'intakeFamilyNotes',
              'intakeSpecialNeedsConditionType',
              'intakeNeedsCompanion',
              'intakeMobilitySupport',
              'intakeNutritionSupport',
              'intakeSpecialCareNotes',
              'updatedAt'
            ])
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.centerId == resource.data.centerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.intakeFormSubmitted == true;
    }

    function centerRecommendationValid() {
      return signedIn()
        && isLegacyOrCanonicalCenterBooking()
        && (resource.data.centerId is string)
        && resource.data.centerId == uid()
        && resource.data.status == 'center_recommendation_pending'
        && request.resource.data.status == 'session_setup_pending'
        && request.resource.data.workflowStage == 'session_setup_pending'
        && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly([
              'status',
              'workflowStage',
              'centerInitialRecommendation',
              'centerRecommendedCareLevel',
              'centerRecommendedStayDays',
              'centerNeedsInternalAssessment',
              'centerRecommendationNotes',
              'centerRecommendationSubmittedAt',
              'centerRecommendationSubmittedBy',
              'updatedAt'
            ])
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.centerId == resource.data.centerId
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.centerInitialRecommendation is string)
        && request.resource.data.centerInitialRecommendation.size() > 0
        && (request.resource.data.centerRecommendedCareLevel is string)
        && request.resource.data.centerRecommendedCareLevel.size() > 0
        && (request.resource.data.centerRecommendedStayDays is int)
        && request.resource.data.centerRecommendedStayDays > 0
        && (request.resource.data.centerNeedsInternalAssessment is bool)
        && (request.resource.data.centerRecommendationSubmittedBy is string)
        && request.resource.data.centerRecommendationSubmittedBy == uid();
    }

    function clientCenterResubmitValid() {
      return isClientDoc()
        && resource.data.requestKind == 'center'
        && resource.data.status == 'client_update_required'
        && request.resource.data.status == 'pending_admin'
        && request.resource.data.workflowStage == 'pending_admin'
        && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly([
              'status',
              'workflowStage',
              'note',
              'selectedAccommodationKey',
              'selectedAccommodationLabelAr',
              'selectedAccommodationPricingSnapshot',
              'selectedAccommodationPrice',
              'selectedAccommodationPricingUnit',
              'centerAvailabilityStatus',
              'centerAvailabilityNote',
              'centerAvailabilityRespondedAt',
              'centerAvailabilityRespondedBy',
              'centerSuggestedAlternativeKey',
              'centerSuggestedAlternativeLabelAr',
              'lastCenterAvailabilityStatus',
              'lastCenterAvailabilityNote',
              'lastCenterSuggestedAlternativeKey',
              'lastCenterSuggestedAlternativeLabelAr',
              'clientRevisionNumber',
              'clientUpdatedAfterCenterFeedback',
              'adminCanApproveWithoutCenterRecheck',
              'updatedAt'
            ])
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.clientName == resource.data.clientName
        && request.resource.data.centerId == resource.data.centerId
        && request.resource.data.centerName == resource.data.centerName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.centerAvailabilityStatus == 'pending'
        && request.resource.data.clientUpdatedAfterCenterFeedback == true;
    }

    function clinicianUpdateValid() {
      return isAssignedClinicianDoc()
        && (
          (
            resource.data.status == 'assigned_clinician'
            && request.resource.data.status == 'awaiting_payment'
            && request.resource.data.diff(resource.data).changedKeys()
                .hasOnly([
                  'status',
                  'updatedAt',
                  'clinicianAccepted',
                  'clinicianRejected',
                  'clinicianCompleted',
                  'clinicianRespondedAt',
                  'payment_confirmed',
                  'paymentStatus',
                  'sessionStatus',
                  'reviewStatus',
                  'payoutStatus'
                ])
          )
          ||
          (
            resource.data.status == 'assigned_clinician'
            && request.resource.data.status == 'clinician_rejected'
            && request.resource.data.diff(resource.data).changedKeys()
                .hasOnly([
                  'status',
                  'updatedAt',
                  'clinicianAccepted',
                  'clinicianRejected',
                  'clinicianCompleted',
                  'clinicianRespondedAt',
                  'paymentStatus',
                  'sessionStatus',
                  'reviewStatus',
                  'payoutStatus'
                ])
          )
          ||
          (
            (
              resource.data.status == 'session_scheduled'
              || resource.data.status == 'session_in_progress'
            )
            && request.resource.data.status == 'session_completed_pending_reviews'
            && request.resource.data.diff(resource.data).changedKeys()
                .hasOnly([
                  'status',
                  'updatedAt',
                  'clinicianAccepted',
                  'clinicianRejected',
                  'clinicianCompleted',
                  'completedAt',
                  'reviewStatus',
                  'payoutStatus'
                ])
          )
        );
    }

    function reviewBaseFieldsUnchanged() {
      let centerIdUnchanged =
        (
          !resource.data.keys().hasAny(['centerId'])
          && !request.resource.data.keys().hasAny(['centerId'])
        )
        || (
          resource.data.keys().hasAny(['centerId'])
          && request.resource.data.keys().hasAny(['centerId'])
          && request.resource.data.centerId == resource.data.centerId
        );

      let centerNameUnchanged =
        (
          !resource.data.keys().hasAny(['centerName'])
          && !request.resource.data.keys().hasAny(['centerName'])
        )
        || (
          resource.data.keys().hasAny(['centerName'])
          && request.resource.data.keys().hasAny(['centerName'])
          && request.resource.data.centerName == resource.data.centerName
        );

      let assignedClinicianIdUnchanged =
        (
          !resource.data.keys().hasAny(['assignedClinicianId'])
          && !request.resource.data.keys().hasAny(['assignedClinicianId'])
        )
        || (
          resource.data.keys().hasAny(['assignedClinicianId'])
          && request.resource.data.keys().hasAny(['assignedClinicianId'])
          && request.resource.data.assignedClinicianId == resource.data.assignedClinicianId
        );

      let assignedClinicianNameUnchanged =
        (
          !resource.data.keys().hasAny(['assignedClinicianName'])
          && !request.resource.data.keys().hasAny(['assignedClinicianName'])
        )
        || (
          resource.data.keys().hasAny(['assignedClinicianName'])
          && request.resource.data.keys().hasAny(['assignedClinicianName'])
          && request.resource.data.assignedClinicianName == resource.data.assignedClinicianName
        );

      let requestGroupIdUnchanged =
        (
          !resource.data.keys().hasAny(['requestGroupId'])
          && !request.resource.data.keys().hasAny(['requestGroupId'])
        )
        || (
          resource.data.keys().hasAny(['requestGroupId'])
          && request.resource.data.keys().hasAny(['requestGroupId'])
          && request.resource.data.requestGroupId == resource.data.requestGroupId
        );

      return request.resource.data.requestKind == resource.data.requestKind
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.clientName == resource.data.clientName
        && centerIdUnchanged
        && centerNameUnchanged
        && request.resource.data.clinicianId == resource.data.clinicianId
        && request.resource.data.clinicianName == resource.data.clinicianName
        && request.resource.data.clinicianUid == resource.data.clinicianUid
        && assignedClinicianIdUnchanged
        && assignedClinicianNameUnchanged
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.note == resource.data.note
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.payoutStatus == resource.data.payoutStatus
        && request.resource.data.adminForwarded == resource.data.adminForwarded
        && request.resource.data.adminAssignedBy == resource.data.adminAssignedBy
        && request.resource.data.adminAssignedAt == resource.data.adminAssignedAt
        && requestGroupIdUnchanged;
    }

    function clientReviewUpdateValid() {
      return request.auth != null
        && request.auth.uid == resource.data.clientId
        && (
          resource.data.status == 'session_completed_pending_reviews'
          || resource.data.status == 'payout_pending'
        )
        && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly([
              'clientReviewSubmitted',
              'clientReviewSubmittedAt',
              'clientReviewTotalScore',
              'clientReviewPercentage',
              'clientReviewDerivedStars',
              'status',
              'reviewStatus',
              'sessionStatus',
              'finalReviewPercentage',
              'updatedAt'
            ])
        && request.resource.data.clientReviewSubmitted == true
        && request.resource.data.sessionStatus == 'completed'
        && (
          request.resource.data.status == 'session_completed_pending_reviews'
          || request.resource.data.status == 'payout_pending'
        )
        && (
          request.resource.data.reviewStatus == 'partial'
          || request.resource.data.reviewStatus == 'completed'
        );
    }

    function clientReviewBridgeValid() {
      return request.auth != null
        && request.auth.uid == resource.data.clientId
        && (
          resource.data.status == 'session_completed_pending_reviews'
          || resource.data.status == 'payout_pending'
        )
        && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly([
              'clientReviewSubmitted',
              'clientReviewSubmittedAt',
              'clientReviewTotalScore',
              'clientReviewPercentage',
              'clientReviewDerivedStars',
              'status',
              'reviewStatus',
              'sessionStatus',
              'finalReviewPercentage',
              'updatedAt'
            ])
        && request.resource.data.clientReviewSubmitted == true
        && request.resource.data.sessionStatus == 'completed'
        && (
          request.resource.data.status == 'session_completed_pending_reviews'
          || request.resource.data.status == 'payout_pending'
        )
        && (
          request.resource.data.reviewStatus == 'partial'
          || request.resource.data.reviewStatus == 'completed'
        );
    }

    function clinicianReviewUpdateValid() {
      return (
          isAssignedClinicianDoc()
          || (
            signedIn()
            && isLegacyOrCanonicalCenterBooking()
            && (resource.data.centerId is string)
            && resource.data.centerId == uid()
          )
        )
        && (
          resource.data.status == 'session_completed_pending_reviews'
          || resource.data.status == 'payout_pending'
        )
        && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly([
              'clinicianReviewSubmitted',
              'clinicianReviewSubmittedAt',
              'clinicianReviewTotalScore',
              'clinicianReviewPercentage',
              'clinicianReviewDerivedStars',
              'status',
              'reviewStatus',
              'sessionStatus',
              'finalReviewPercentage',
              'updatedAt'
            ])
        && request.resource.data.clinicianReviewSubmitted == true
        && request.resource.data.sessionStatus == 'completed'
        && (
          request.resource.data.status == 'session_completed_pending_reviews'
          || request.resource.data.status == 'payout_pending'
        )
        && (
          request.resource.data.reviewStatus == 'partial'
          || request.resource.data.reviewStatus == 'completed'
        );
    }

    function centerDischargeReviewBridgeValid() {
      return signedIn()
        && isLegacyOrCanonicalCenterBooking()
        && (resource.data.centerId is string)
        && resource.data.centerId == uid()
        && (
          resource.data.status == 'session_completed_pending_reviews'
          || resource.data.status == 'payout_pending'
        )
        && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly([
              'clinicianReviewSubmitted',
              'clinicianReviewSubmittedAt',
              'clinicianReviewTotalScore',
              'clinicianReviewPercentage',
              'clinicianReviewDerivedStars',
              'status',
              'reviewStatus',
              'sessionStatus',
              'finalReviewPercentage',
              'updatedAt'
            ])
        && request.resource.data.clinicianReviewSubmitted == true
        && request.resource.data.sessionStatus == 'completed'
        && (
          request.resource.data.status == 'session_completed_pending_reviews'
          || request.resource.data.status == 'payout_pending'
        )
        && (
          request.resource.data.reviewStatus == 'partial'
          || request.resource.data.reviewStatus == 'completed'
        );
    }

    function centerReviewUpdateValid() {
      return signedIn()
        && isLegacyOrCanonicalCenterBooking()
        && (resource.data.centerId is string)
        && resource.data.centerId == uid()
        && (
          resource.data.status == 'session_completed_pending_reviews'
          || resource.data.status == 'payout_pending'
        )
        && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly([
              'centerReviewSubmitted',
              'centerReviewSubmittedAt',
              'centerReviewTotalScore',
              'centerReviewPercentage',
              'centerReviewDerivedStars',
              'status',
              'reviewStatus',
              'sessionStatus',
              'finalReviewPercentage',
              'updatedAt'
            ])
        && request.resource.data.centerReviewSubmitted == true
        && request.resource.data.sessionStatus == 'completed'
        && (
          request.resource.data.status == 'session_completed_pending_reviews'
          || request.resource.data.status == 'payout_pending'
        )
        && (
          request.resource.data.reviewStatus == 'partial'
          || request.resource.data.reviewStatus == 'completed'
        );
    }

    function clinicianCanReadEscalation() {
      return signedIn()
        && (resource.data.assignedToType is string)
        && (resource.data.assignedToUid is string)
        && resource.data.assignedToType == 'clinician'
        && resource.data.assignedToUid == uid();
    }

    function clinicianCanReadEscalationById(escalationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chat_escalations/$(escalationId))
        && (get(/databases/$(database)/documents/chat_escalations/$(escalationId)).data.assignedToType is string)
        && (get(/databases/$(database)/documents/chat_escalations/$(escalationId)).data.assignedToUid is string)
        && get(/databases/$(database)/documents/chat_escalations/$(escalationId)).data.assignedToType == 'clinician'
        && get(/databases/$(database)/documents/chat_escalations/$(escalationId)).data.assignedToUid == uid();
    }

    function isThreadOwnerDoc() {
      return signedIn()
        && (resource.data.ownerUid is string)
        && resource.data.ownerUid == uid();
    }

    function isThreadAssignedClinicianDoc() {
      return signedIn()
        && (resource.data.assignedClinicianUid is string)
        && resource.data.assignedClinicianUid == uid();
    }

    function canReadThreadDoc() {
      return isAdmin() || isThreadOwnerDoc() || isThreadAssignedClinicianDoc();
    }

    function canReadThreadById(threadId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chat_threads/$(threadId))
        && (
          isAdmin()
          || (
            get(/databases/$(database)/documents/chat_threads/$(threadId)).data.ownerUid is string
            && get(/databases/$(database)/documents/chat_threads/$(threadId)).data.ownerUid == uid()
          )
          || (
            get(/databases/$(database)/documents/chat_threads/$(threadId)).data.assignedClinicianUid is string
            && get(/databases/$(database)/documents/chat_threads/$(threadId)).data.assignedClinicianUid == uid()
          )
        );
    }

    match /booking_requests/{docId} {
      allow read: if clientCanReadBooking() || clinicianCanReadBooking() || centerCanReadBooking() || isAdmin();

      allow create: if clinicianBookingCreateValid()
        || centerBookingCreateValid();

      allow update: if adminCenterFollowUpBridgeValid()
        || adminCenterReturnToClientBridgeValid()
        || adminCenterApproveBridgeValid()
        || adminCenterScheduleBridgeValid()
        || adminPaymentApproveBridgeValid()
        || centerArrivalBridgeValid()
        || clientCenterCheckInBridgeValid()
        || adminSessionCompleteBridgeValid()
        || centerAvailabilityBridgeValid()
        || centerDischargeReviewBridgeValid()
        || clientReviewBridgeValid()
        || adminCenterAccountingReviewBridgeValid()
        || adminPayoutConfirmBridgeValid()
        || adminArchiveBridgeValid()
        || clientUpdateValid()
        || clientInitialIntakeValid()
          || centerRecommendationValid()
          || clientCenterResubmitValid()
          || clientCenterCheckInValid()
          || clientPaymentProofUpdateValid()
          || adminClinicianForwardValid()
          || adminForwardValid()
          || adminRejectValid()
          || adminReturnToPendingValid()
          || adminPaymentUpdateValid()
        || adminSessionUpdateValid()
        || adminPayoutAndArchiveValid()
        || (
          isCenterCycleAdmin()
          && resource.data.requestKind == 'center'
          && (
            resource.data.status == 'center_follow_up'
            || (
              resource.data.status == 'pending_admin'
              && resource.data.clientUpdatedAfterCenterFeedback == true
            )
          )
          && request.resource.data.status == 'session_setup_pending'
          && request.resource.data.workflowStage == 'session_setup_pending'
        )
        || adminCenterUpdateValid()
        || centerArrivalConfirmationValid()
        || centerAvailabilityUpdateValid()
        || clinicianUpdateValid()
        || clientReviewUpdateValid()
        || clinicianReviewUpdateValid()
        || centerReviewUpdateValid();

      allow delete: if false;
    }

    match /bookingRequests/{docId} {
      allow read, create, update, delete: if false;
    }

    match /chat_threads/{threadId} {
      allow read: if canReadThreadDoc();

      allow create: if signedIn()
        && (request.resource.data.ownerUid is string)
        && request.resource.data.ownerUid == uid();

      allow update: if isAdmin() || isThreadOwnerDoc();

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if canReadThreadById(threadId);

        allow create: if canReadThreadById(threadId)
          && (
            (
              request.resource.data.senderType == 'user'
              && (request.resource.data.senderUid is string)
              && request.resource.data.senderUid == uid()
            )
            ||
            (
              request.resource.data.senderType == 'admin'
              && isAdmin()
              && (request.resource.data.senderUid is string)
              && request.resource.data.senderUid == uid()
            )
            ||
            (
              request.resource.data.senderType == 'ai'
              && !('senderUid' in request.resource.data)
            )
            ||
            (
              request.resource.data.senderType == 'ai'
              && request.resource.data.senderUid == null
            )
          );

        allow update, delete: if false;
      }
    }

    match /clinicians/{uidDoc} {
      allow read: if signedIn();
      allow create: if signedIn() && uid() == uidDoc;
      allow update: if ownClinicianUpdateValid(uidDoc) || isAdmin();
      allow delete: if false;
    }

    match /clients/{uidDoc} {
      allow read: if isAdmin() || isOwnClientResource(uidDoc);
      allow create: if isAdmin() || isOwnClientRequest(uidDoc);
      allow update: if isAdmin() || ownClientUpdateValid(uidDoc);
      allow delete: if false;
    }

    match /clinician_profile_change_requests/{requestId} {
      allow read: if isAdmin() || isOwnClinicianProfileRequestResource();

      allow create: if isOwnClinicianProfileRequestCreate()
        && request.resource.data.status == 'pending';

      allow update: if isAdmin();
      allow delete: if false;
    }

    match /center_profile_change_requests/{requestId} {
      allow read: if isAdmin() || isOwnCenterProfileRequestResource();

      allow create: if isOwnCenterProfileRequestCreate()
        && request.resource.data.status == 'pending';

      allow update: if isAdmin();
      allow delete: if false;
    }

    match /sessionRatings/{docId} {
      allow read: if canReadSessionRating();
      allow create: if signedIn()
        && (request.resource.data.reviewerUid is string)
        && request.resource.data.reviewerUid == uid()
        && (request.resource.data.requestId is string)
        && (
          request.resource.data.reviewerType == 'client'
          || request.resource.data.reviewerType == 'clinician'
          || request.resource.data.reviewerType == 'center'
        );
      allow update: if signedIn()
        && resource != null
        && (resource.data.reviewerUid is string)
        && resource.data.reviewerUid == uid()
        && (request.resource.data.reviewerUid is string)
        && request.resource.data.reviewerUid == resource.data.reviewerUid
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.reviewerType == resource.data.reviewerType;
      allow delete: if false;
    }

    match /admins/{uidDoc} {
      allow read: if resource.data.active == true;
      allow write: if false;
    }

    match /resources/{docId} {
      allow read, write: if true;
      allow delete: if false;
    }

    match /centers/{docId} {
      allow read: if signedIn()
        && (
          isAdmin()
          || isOwnCenterResource(docId)
          || (
            resource != null
            && resource.data.isActive == true
          )
        );
      allow create: if isAdmin() || isOwnCenterCreate(docId);
      allow update: if isAdmin() || ownCenterUpdateValid(docId);
      allow delete: if false;
    }

    match /chat_escalations/{escalationId} {
      allow read: if isAdmin() || clinicianCanReadEscalation();
      allow update: if isAdmin();
      allow create: if request.auth != null;
    }

    match /chat_escalations/{escalationId}/reports/{reportId} {
      allow read: if isAdmin() || clinicianCanReadEscalationById(escalationId);
      allow create: if request.auth != null;
    }

    match /debug/{docId} {
      allow read, write: if true;
      allow delete: if false;
    }

    match /system_health/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /ai_policies/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
      allow delete: if false;
    }

    match /system_domains/{domainId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}




