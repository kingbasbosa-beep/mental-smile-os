rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(uid()))
        && get(/databases/$(database)/documents/admins/$(uid())).data.active == true;
    }

    function isCenterCycleAdmin() {
      return isAdmin();
    }

    function isClientDoc() {
      return signedIn()
        && (resource.data.clientId is string)
        && resource.data.clientId == uid();
    }

    function isClinicianDoc() {
      return signedIn()
        && (resource.data.clinicianUid is string)
        && resource.data.clinicianUid == uid();
    }

    function isAssignedClinicianDoc() {
      return signedIn()
        && (
          (
            resource.data.assignedClinicianId is string
            && resource.data.assignedClinicianId == uid()
          )
          ||
          (
            resource.data.assignedClinicianUid is string
            && resource.data.assignedClinicianUid == uid()
          )
          ||
          (
            resource.data.clinicianUid is string
            && resource.data.clinicianUid == uid()
          )
        );
    }

    function clientCanReadBooking() {
      return isClientDoc();
    }

    function clinicianCanReadBooking() {
      return isAssignedClinicianDoc();
    }

    function centerCanReadBooking() {
      return signedIn()
        && resource != null
        && (resource.data.status is string)
        && (
          resource.data.status == 'center_follow_up'
          || resource.data.status == 'center_recommendation_pending'
          || resource.data.status == 'session_setup_pending'
          || resource.data.status == 'session_scheduled'
          || resource.data.status == 'session_in_progress'
          || resource.data.status == 'session_completed_pending_reviews'
          || resource.data.status == 'reschedule_pending'
        )
        && (resource.data.centerId is string)
        && resource.data.centerId == uid();
    }

    function isLegacyOrCanonicalCenterBooking() {
      return resource != null
        && (resource.data.centerId is string)
        && resource.data.centerId.size() > 0
        && (
          (
            resource.data.requestKind is string
            && resource.data.requestKind == 'center'
          )
          || (
            !(resource.data.requestKind is string)
            && (
              (resource.data.centerName is string && resource.data.centerName.size() > 0)
              || resource.data.keys().hasAny(['selectedAccommodationKey'])
              || resource.data.keys().hasAny(['centerAvailabilityStatus'])
            )
          )
        );
    }

    function isOwnClientResource(uidDoc) {
      return signedIn()
        && (
          uidDoc == uid()
          || (
            resource != null
            && resource.data.email is string
            && request.auth.token.email != null
            && resource.data.email == request.auth.token.email
          )
        );
    }

    function isOwnClientRequest(uidDoc) {
      return signedIn()
        && (
          uidDoc == uid()
          || (
            request.resource.data.email is string
            && request.auth.token.email != null
            && request.resource.data.email == request.auth.token.email
          )
        );
    }

    function isOwnClinicianProfileRequestResource() {
      return signedIn()
        && resource != null
        && (resource.data.clinicianId is string)
        && resource.data.clinicianId == uid();
    }

    function isOwnClinicianProfileRequestCreate() {
      return signedIn()
        && (request.resource.data.clinicianId is string)
        && request.resource.data.clinicianId == uid();
    }

    function isOwnCenterProfileRequestResource() {
      return signedIn()
        && resource != null
        && (resource.data.centerId is string)
        && resource.data.centerId == uid();
    }

    function isOwnCenterProfileRequestCreate() {
      return signedIn()
        && (request.resource.data.centerId is string)
        && request.resource.data.centerId == uid();
    }

    function isOwnCenterResource(uidDoc) {
      return signedIn()
        && (
          uidDoc == uid()
          || (
            resource != null
            && resource.data.email is string
            && request.auth.token.email != null
            && resource.data.email == request.auth.token.email
          )
        );
    }

    function isOwnCenterCreate(uidDoc) {
      return signedIn()
        && uidDoc == uid()
        && request.resource.data.role == 'center'
        && request.resource.data.approvalStatus == 'pending_admin'
        && request.resource.data.isActive == false;
    }

    function ownCenterUpdateValid(uidDoc) {
      return signedIn()
        && uidDoc == uid()
        && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly([
              'displayName',
              'centerName',
              'phone',
              'city',
              'address',
              'description',
              'managerName',
              'galleryItems',
              'galleryImages',
              'imagesReady',
              'documentItems',
              'documentsReady',
              'updatedAt'
            ])
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email
        && request.resource.data.approvalStatus == resource.data.approvalStatus
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.active == resource.data.active
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function ownClinicianUpdateValid(uidDoc) {
      return signedIn()
        && uid() == uidDoc
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email
        && request.resource.data.approvalStatus == resource.data.approvalStatus
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.isAdmin == resource.data.isAdmin
        && request.resource.data.isBlocked == resource.data.isBlocked
        && request.resource.data.blockedAt == resource.data.blockedAt
        && request.resource.data.blockedBy == resource.data.blockedBy
        && request.resource.data.blockReason == resource.data.blockReason
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function ownClientUpdateValid(uidDoc) {
      return isOwnClientRequest(uidDoc)
        && resource != null
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email
        && request.resource.data.isBlocked == resource.data.isBlocked
        && request.resource.data.blockedAt == resource.data.blockedAt
        && request.resource.data.blockedBy == resource.data.blockedBy
        && request.resource.data.blockReason == resource.data.blockReason
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function canReadSessionRating() {
      return isAdmin()
        || (
          signedIn()
          && resource != null
          && (
            (
              resource.data.clientId is string
              && resource.data.clientId == uid()
            )
            || (
              resource.data.clinicianId is string
              && resource.data.clinicianId == uid()
            )
            || (
              resource.data.centerId is string
              && resource.data.centerId == uid()
            )
            || (
              resource.data.reviewerUid is string
              && resource.data.reviewerUid == uid()
            )
          )
        );
    }

    function clientUpdateValid() {
      return isClientDoc()
        && (resource.data.status == 'pending_admin')
        && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(['note', 'updatedAt'])
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.clientName == resource.data.clientName
        && request.resource.data.clinicianId == resource.data.clinicianId
        && request.resource.data.clinicianName == resource.data.clinicianName
        && request.resource.data.clinicianUid == resource.data.clinicianUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status == resource.data.status
        && request.resource.data.adminForwarded == resource.data.adminForwarded
        && request.resource.data.adminAssignedBy == resource.data.adminAssignedBy
        && request.resource.data.adminAssignedAt == resource.data.adminAssignedAt;
    }

    function clientPaymentProofUpdateValid() {
      return request.auth != null
        && request.auth.uid == resource.data.clientId
        && resource.data.status == 'awaiting_payment'
        && request.resource.data.status == 'payment_review'
        && request.resource.data.workflowStage == 'payment_review'
        && request.resource.data.paymentStatus == 'submitted_by_client'
        && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly([
              'status',
              'workflowStage',
              'paymentStatus',
              'payment_confirmed',
              'paymentReceiptFileName',
              'paymentReceiptUrl',
              'paymentSubmittedAt',
              'paymentClientNote',
              'updatedAt'
            ])
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.clientName == resource.data.clientName
        && request.resource.data.clinicianId == resource.data.clinicianId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.note == resource.data.note
        && (
          (
            !resource.data.keys().hasAny(['centerId'])
            && !request.resource.data.keys().hasAny(['centerId'])
          )
          || (
            resource.data.keys().hasAny(['centerId'])
            && request.resource.data.keys().hasAny(['centerId'])
            && request.resource.data.centerId == resource.data.centerId
          )
        );
    }

    function adminForwardValid() {
      return isAdmin()
        && (resource.data.status == 'pending_admin')
        && (request.resource.data.status == 'assigned_clinician')
        && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly([
              'status',
              'workflowStage',
              'adminApproved',
              'adminRejected',
              'clinicianId',
              'clinicianName',
              'clinicianUid',
              'assignedClinicianId',
              'assignedClinicianName',
              'adminForwarded',
              'adminAssignedBy',
              'adminAssignedAt',
              'adminDecisionType',
              'adminDecisionBy',
              'adminDecisionAt',
              'paymentStatus',
              'payment_confirmed',
              'sessionStatus',
              'reviewStatus',
              'payoutStatus',
              'updatedAt'
            ])
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.clientName == resource.data.clientName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.note == resource.data.note
        && (request.resource.data.clinicianId is string)
        && request.resource.data.clinicianId.size() > 0
        && (request.resource.data.clinicianName is string)
        && request.resource.data.clinicianName.size() > 0
        && (request.resource.data.clinicianUid is string)
        && request.resource.data.clinicianUid.size() > 0
        && request.resource.data.adminForwarded == true
        && (request.resource.data.adminAssignedBy is string)
        && request.resource.data.adminAssignedBy == uid();
    }

    function adminClinicianForwardValid() {
      return isAdmin()
        && (resource.data.requestKind is string)
        && resource.data.requestKind == 'clinician'
        && resource.data.status == 'pending_admin'
        && request.resource.data.status == 'assigned_clinician'
        && request.resource.data.workflowStage == 'assigned_clinician'
        && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly([
              'status',
              'workflowStage',
              'adminApproved',
              'adminRejected',
              'adminForwarded',
              'assignedClinicianId',
              'assignedClinicianName',
              'adminAssignedBy',
              'adminAssignedAt',
              'adminDecisionType',
              'adminDecisionBy',
              'adminDecisionAt',
              'paymentStatus',
              'payment_confirmed',
              'sessionStatus',
              'reviewStatus',
              'payoutStatus',
              'updatedAt'
            ])
        && request.resource.data.clinicianId == resource.data.clinicianId
        && request.resource.data.clinicianName == resource.data.clinicianName
        && request.resource.data.clinicianUid == resource.data.clinicianUid
        && request.resource.data.assignedClinicianId == resource.data.clinicianId
        && request.resource.data.adminApproved == true
        && request.resource.data.adminRejected == false
        && request.resource.data.adminForwarded == true
        && request.resource.data.adminDecisionType == 'assigned'
        && request.resource.data.adminAssignedBy == request.auth.uid
        && request.resource.data.adminDecisionBy == request.auth.uid
        && request.resource.data.paymentStatus == 'not_started'
        && request.resource.data.sessionStatus == 'not_created'
        && request.resource.data.reviewStatus == 'not_started'
        && request.resource.data.payoutStatus == 'blocked';
    }

    function adminRejectValid() {
      return isAdmin()
        && request.resource.data.status == 'rejected_admin'
        && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly([
              'status',
              'workflowStage',
              'adminApproved',
              'adminRejected',
              'adminForwarded',
              'adminDecisionType',
              'adminDecisionBy',
              'adminDecisionAt',
              'adminAssignedBy',
              'adminAssignedAt',
              'paymentStatus',
              'payment_confirmed',
              'sessionStatus',
              'reviewStatus',
              'payoutStatus',
              'updatedAt'
            ])
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.clientName == resource.data.clientName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.note == resource.data.note;
    }

    function adminReturnToPendingValid() {
      return isAdmin()
        && request.resource.data.status == 'pending_admin'
        && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly([
              'status',
              'workflowStage',
              'adminApproved',
              'adminRejected',
              'adminForwarded',
              'adminAssignedBy',
              'adminAssignedAt',
              'adminDecisionType',
              'adminDecisionBy',
              'adminDecisionAt',
              'assignedClinicianId',
              'assignedClinicianName',
              'clinicianId',
              'clinicianName',
              'clinicianUid',
              'paymentStatus',
              'payment_confirmed',
              'sessionStatus',
              'reviewStatus',
              'payoutStatus',
              'updatedAt'
            ])
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.clientName == resource.data.clientName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.note == resource.data.note;
    }

    function adminPaymentApproveValid() {
      return isAdmin()
        && (
          resource.data.status == 'payment_review'
          || resource.data.paymentStatus == 'submitted_by_client'
          || (
            resource.data.status == 'awaiting_payment'
            && (resource.data.paymentReceiptFileName is string)
            && resource.data.paymentReceiptFileName.size() > 0
          )
        )
        && request.resource.data.paymentStatus == 'approved'
        && (
          (
            isLegacyOrCanonicalCenterBooking()
            && request.resource.data.status == 'session_scheduled'
            && request.resource.data.workflowStage == 'session_scheduled'
            && request.resource.data.sessionStatus == 'scheduled'
            && request.resource.data.diff(resource.data).changedKeys()
                .hasOnly([
                  'status',
                  'workflowStage',
                  'paymentStatus',
                  'payment_confirmed',
                  'paymentApprovedAt',
                  'sessionStatus',
                  'updatedAt'
                ])
          )
          || (
            !isLegacyOrCanonicalCenterBooking()
            && request.resource.data.status == 'session_setup_pending'
            && request.resource.data.workflowStage == 'session_setup_pending'
            && request.resource.data.sessionStatus == 'not_created'
            && request.resource.data.diff(resource.data).changedKeys()
                .hasOnly([
                  'status',
                  'workflowStage',
                  'paymentStatus',
                  'payment_confirmed',
                  'paymentApprovedAt',
                  'sessionStatus',
                  'updatedAt'
                ])
          )
        )
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.clientName == resource.data.clientName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.note == resource.data.note;
    }

    function adminPaymentRejectValid() {
      return isAdmin()
        && (
          resource.data.status == 'payment_review'
          || resource.data.paymentStatus == 'submitted_by_client'
          || (
            resource.data.status == 'awaiting_payment'
            && (resource.data.paymentReceiptFileName is string)
            && resource.data.paymentReceiptFileName.size() > 0
          )
        )
        && request.resource.data.status == 'awaiting_payment'
        && request.resource.data.paymentStatus == 'rejected'
        && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly([
              'status',
              'workflowStage',
              'paymentStatus',
              'payment_confirmed',
              'paymentRejectedAt',
              'updatedAt'
            ])
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.clientName == resource.data.clientName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.note == resource.data.note;
    }

    function adminPaymentUpdateValid() {
      return adminPaymentApproveValid() || adminPaymentRejectValid();
    }

    function adminSessionScheduleValid() {
      return isAdmin()
        && (
          resource.data.status == 'session_setup_pending'
          || resource.data.status == 'reschedule_pending'
        )
        && (
          (
            isLegacyOrCanonicalCenterBooking()
            && request.resource.data.status == 'awaiting_payment'
            && request.resource.data.workflowStage == 'awaiting_payment'
            && request.resource.data.paymentStatus == 'pending_client_transfer'
            && request.resource.data.sessionStatus == 'not_created'
            && request.resource.data.diff(resource.data).changedKeys()
                .hasOnly([
                  'status',
                  'workflowStage',
                  'paymentStatus',
                  'payment_confirmed',
                  'sessionStatus',
                  'sessionDateText',
                  'stayStartDateText',
                  'stayEndDateText',
                  'stayDurationDays',
                  'stayDurationReason',
                  'stayDurationIsPreliminary',
                  'sessionLink',
                  'sessionCode',
                  'sessionAdminNotes',
                  'stayUnitPrice',
                  'stayPricingUnit',
                  'stayBaseAmount',
                  'stayTaxPercent',
                  'stayTaxAmount',
                  'stayTotalAmount',
                  'grossClientPaidAmount',
                  'paymentBreakdownText',
                  'paymentQuotePreparedAt',
                  'paymentQuotePreparedBy',
                  'updatedAt'
                ])
          )
          || (
            !isLegacyOrCanonicalCenterBooking()
            && request.resource.data.status == 'session_scheduled'
            && request.resource.data.workflowStage == 'session_scheduled'
            && request.resource.data.sessionStatus == 'scheduled'
            && request.resource.data.diff(resource.data).changedKeys()
                .hasOnly([
                  'status',
                  'workflowStage',
                  'sessionStatus',
                  'sessionDateText',
                  'sessionLink',
                  'sessionCode',
                  'sessionAdminNotes',
                  'sessionCreatedAt',
                  'updatedAt'
                ])
          )
        )
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.clientName == resource.data.clientName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.note == resource.data.note;
    }

    function adminSessionInProgressValid() {
      return isAdmin()
        && resource.data.status == 'session_scheduled'
        && request.resource.data.status == 'session_in_progress'
        && request.resource.data.workflowStage == 'session_in_progress'
        && request.resource.data.sessionStatus == 'in_progress'
        && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly([
              'status',
              'workflowStage',
              'sessionStatus',
              'updatedAt'
            ])
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.clientName == resource.data.clientName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.note == resource.data.note;
    }

    function adminSessionCompleteValid() {
      return isAdmin()
        && (
          resource.data.status == 'session_scheduled'
          || resource.data.status == 'session_in_progress'
        )
        && request.resource.data.status == 'session_completed_pending_reviews'
        && request.resource.data.workflowStage == 'session_completed_pending_reviews'
        && request.resource.data.sessionStatus == 'completed'
        && request.resource.data.reviewStatus == 'pending_reviews'
        && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly([
              'status',
              'workflowStage',
              'sessionStatus',
              'reviewStatus',
              'updatedAt'
            ])
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.clientName == resource.data.clientName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.note == resource.data.note;
    }

    function adminSessionRescheduleValid() {
      return isAdmin()
        && (
          resource.data.status == 'session_scheduled'
          || resource.data.status == 'session_in_progress'
        )
        && request.resource.data.status == 'reschedule_pending'
        && request.resource.data.workflowStage == 'reschedule_pending'
        && request.resource.data.sessionStatus == 'reschedule_pending'
        && request.resource.data.diff(resource.data).changedKeys()
            .hasOnly([
              'status',
              'workflowStage',
              'sessionStatus',
              'updatedAt'
            ])
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.clientName == resource.data.clientName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.note == resource.data.note;
    }

    function adminSessionUpdateValid() {
      return adminSessionScheduleValid()
        || adminSessionInProgressValid()
        || adminSessionCompleteValid()
        || adminSessionRescheduleValid();
    }

    function centerResidencyBaseUnchanged() {
      return (
          (
            request.resource.data.requestKind == resource.data.requestKind
          )
          || (
            !(resource.data.requestKind is string)
            && (
              !(request.resource.data.requestKind is string)
              || request.resource.data.requestKind == 'center'
            )
          )
        )
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.clientName == resource.data.clientName
        && request.resource.data.centerId == resource.data.centerId
        && request.resource.data.centerName == resource.data.centerName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.note == resource.data.note;
    }

    function centerArrivalConfirmationValid() {
      return signedIn()
        && isLegacyOrCanonicalCenterBooking()
        && resource.data.centerId == uid()
        && (
          resource.data.status == 'session_setup_pending'
          || resource.data.status == 'session_scheduled'
          || resource.data.status == 'reschedule_pending'
        )
        && request.resource.data.centerArrivalConfirmed == true
        && request.resource.data.centerArrivalConfirmedBy == uid()
        && centerResidencyBaseUnchanged()
        && (
          (
            (resource.data.clientCheckInConfirmed != true)
            && request.resource.data.status == resource.data.status
            && request.resource.data.sessionStatus == resource.data.sessionStatus
            && request.resource.data.diff(resource.data).changedKeys()
                .hasOnly([
                  'centerArrivalConfirmed',
                  'centerArrivalConfirmedAt',
                  'centerArrivalConfirmedBy',
                  'centerArrivalNotes',
                  'centerRoomDeliveredAsBooked',
                  'updatedAt'
                ])
          )
          || (
            resource.data.clientCheckInConfirmed == true
            && request.resource.data.status == 'session_in_progress'
            && request.resource.data.workflowStage == 'session_in_progress'
            && request.resource.data.sessionStatus == 'in_progress'
            && request.resource.data.residencyStartedBy == 'center'
            && request.resource.data.diff(resource.data).changedKeys()
                .hasOnly([
                  'centerArrivalConfirmed',
                  'centerArrivalConfirmedAt',
                  'centerArrivalConfirmedBy',
                  'centerArrivalNotes',
                  'centerRoomDeliveredAsBooked',
                  'status',
                  'workflowStage',
                  'sessionStatus',
                  'residencyStartedAt',
                  'residencyStartedBy',
                  'residencyStatus',
                  'updatedAt'
                ])
          )
        );
    }

    function clientCenterCheckInValid() {
      return signedIn()
        && isLegacyOrCanonicalCenterBooking()
        && request.auth.uid == resource.data.clientId
        && (
          resource.data.status == 'session_setup_pending'
          || resource.data.status == 'session_scheduled'
          || resource.data.status == 'reschedule_pending'
        )
        && request.resource.data.clientCheckInConfirmed == true
        && centerResidencyBaseUnchanged()
        && (
          (
            (resource.data.centerArrivalConfirmed != true)
            && request.resource.data.status == resource.data.status
            && request.resource.data.sessionStatus == resource.data.sessionStatus
            && request.resource.data.diff(resource.data).changedKeys()
                .hasOnly([
                  'clientCheckInConfirmed',
                  'clientCheckInConfirmedAt',
                  'clientCheckInNotes',
                  'clientArrivalPlaceMatched',
                  'clientArrivalRightsExplained',
                  'clientArrivalSpecialistMet',
                  'clientArrivalReceptionRating',
                  'updatedAt'
                ])
          )
          || (
            resource.data.centerArrivalConfirmed == true
            && request.resource.data.status == 'session_in_progress'
            && request.resource.data.workflowStage == 'session_in_progress'
